# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@db:5432/motorespuesto

# ── Seguridad — OBLIGATORIO cambiar en producción ─────────────────────────────
# Generá una clave segura con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=323432425243243242324243223454535646753243535653532535642422535

# Contraseña del usuario root (si no se define, el backend NO arranca en producción)
ROOT_PASSWORD=root

# Tiempo de vida del token en minutos (default 480 = 8 horas)
TOKEN_EXPIRE_MINUTES=300

# ── CORS — orígenes permitidos (separados por coma) ───────────────────────────
# En desarrollo:
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# En producción agregar tu dominio:
# ALLOWED_ORIGINS=https://tudominio.com